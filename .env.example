# CreatorSpark Environment Variables Template
# Copy this file to .env and fill in your values for local development.

# Django Settings
DJANGO_SECRET_KEY=replace-with-a-secure-random-secret-key-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# Database Settings
# Local default is sqlite:///db.sqlite3
# For PostgreSQL on Render: postgresql://user:password@hostname:5432/dbname
DATABASE_URL=sqlite:///db.sqlite3

# MongoDB Settings (for Chat History and Feedback)
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DATABASE=creatorspark_db

# Third-Party APIs
# Pexels API Key for visual inspiration gallery (free at https://www.pexels.com/api/)
PEXELS_API_KEY=

# Optional AI Provider (Future expansion)
OPENAI_API_KEY=
GEMINI_API_KEY=
